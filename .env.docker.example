# Caminho da pasta que contém pom.xml e Dockerfile do backend.
BACKEND_CONTEXT=C:/caminho/para/projeto/projeto
FRONTEND_PORT=3000

# O script scripts/iniciar-docker.ps1 solicita as credenciais no PowerShell.
# Para uso manual do Compose, forneça estas variáveis no ambiente do processo:
# DB_URL=jdbc:postgresql://SEU-HOST:5432/projeto_intercambio?sslmode=require
# DB_USERNAME=SEU_USUARIO
# DB_PASSWORD=senha informada localmente
# JWT_SECRET=chave privada com pelo menos 32 bytes
